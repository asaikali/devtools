{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "./data"
  },
  "http": {
    "address": "127.0.0.1",
    "port": "5000",
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "info",
    "output": "./zot.log"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "manifestCheckInterval": "5m",
          "maxRetries": 3,
          "retryDelay": "5s",
          "content": [
            { "prefix": "**" }
          ]
        }
      ]
    }
  }
}
